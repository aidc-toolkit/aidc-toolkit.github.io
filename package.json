{
  "name": "@aidc-toolkit/google-add-on",
  "version": "1.1.0",
  "description": "Google add-on for AIDC Toolkit",
  "type": "module",
  "private": true,
  "homepage": "https://aidc-toolkit.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aidc-toolkit/google-add-on.git"
  },
  "bugs": {
    "url": "https://github.com/aidc-toolkit/google-add-on/issues"
  },
  "author": {
    "name": "Kevin Dean",
    "email": "Kevin.Dean@datadevelopment.com",
    "url": "https://www.linkedin.com/in/kdean"
  },
  "scripts": {
    "generate-source": "tsc --project tsconfig-src-generator.json --noEmit && tsx src/generator/generator.ts",
    "lint": "eslint",
    "build:base": "tsc --project tsconfig-src.json --noEmit && clasp push",
    "build:alpha": "npm run build:base && tsc --project tsconfig-config.json --noEmit",
    "build:beta": "npm run generate-source && npm run build:base",
    "build:prod": "npm run build:beta"
  },
  "devDependencies": {
    "@aidc-toolkit/dev": "^1.0.47",
    "@google/clasp": "^3.3.0",
    "@types/google-apps-script": "^2.0.11",
    "esbuild": "^0.28.0",
    "esbuild-plugin-polyfill-node": "^0.3.0"
  },
  "dependencies": {
    "@aidc-toolkit/app-extension": "^1.1.1-alpha",
    "@aidc-toolkit/core": "^1.0.48"
  }
}
